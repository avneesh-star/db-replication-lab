    {
      "id": 11,
      "type": "stat",
      "title": "Current role of each node",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "PRIMARY takes writes. SYNC STANDBY has every committed write and is the preferred failover target. REPLICA streams asynchronously. DOWN = Patroni is not responding.",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace((patroni_primary * 3 + patroni_sync_standby * 2 + (patroni_replica - patroni_sync_standby)) or on(instance) (up{job=\"patroni\"} * 0), \"node\", \"$1\", \"instance\", \"(.*):8008\")",
          "legendFormat": "{{node}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "3": {
                  "text": "PRIMARY",
                  "color": "blue",
                  "index": 0
                },
                "2": {
                  "text": "SYNC STANDBY",
                  "color": "green",
                  "index": 1
                },
                "1": {
                  "text": "REPLICA",
                  "color": "light-green",
                  "index": 2
                },
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 3
                }
              }
            }
          ],
          "noValue": "DOWN",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "vertical",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
